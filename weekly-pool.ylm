name: Weekly pooled history study

on:
  schedule:
    - cron: "0 9 * * 0"      # Sundays, early morning US time
  workflow_dispatch:
    inputs:
      with_earnings:
        description: "Include earnings-beat bucket (slower; may hit Yahoo limits)"
        type: boolean
        default: true

permissions:
  contents: write

jobs:
  pool:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: pip install -r requirements.txt
      - name: Build pooled statistics
        env:
          WITH_EARNINGS: ${{ inputs.with_earnings }}
        run: |
          ARGS=""
          [ "$WITH_EARNINGS" = "false" ] && ARGS="--no-earnings"
          python run_pool.py $ARGS
      - name: Save results
        run: |
          git config user.name "screener-bot"
          git config user.email "screener-bot@users.noreply.github.com"
          git add data/pool_stats.json data/universe_cache.json || true
          if ! git diff --cached --quiet; then
            git commit -m "Update pooled statistics"
            git pull --rebase
            git push
          fi
